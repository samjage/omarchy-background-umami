#!/bin/bash
# Runs each time the plugin loads. If Background Umami is not set up yet, offer
# the setup once, in Omarchy's floating terminal. Enabling a plugin otherwise
# does nothing visible, and Omarchy never runs a plugin's installer for it.
#
# The offer is made once. Setting up, or removing Umami with umami-uninstall,
# resets it.

set -uo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
source "$root/lib/common.sh"
source "$root/lib/menu.sh"
source "$root/lib/hook.sh"

# Taking the flag is the only step that can race (the shell may load the plugin
# twice in a row), so it is done atomically: the loser leaves quietly.
offer_setup() {
  local offered="$UMAMI_STATE/offered"
  mkdir -p "$UMAMI_STATE"
  if ( set -o noclobber; : >"$offered" ) 2>/dev/null; then
    omarchy-launch-floating-terminal-with-presentation "$root/bin/umami-install"
  fi
}

# Set up before, but not current: an older plugin version wrote the rows or the
# hook, or Omarchy moved its Background row (Style became Appearance in 4.5).
# Rewrite them. The person already agreed to Umami, so this is not offered again.
block_is_stale() {
  local file
  file=$(umami_menu_file 2>/dev/null) || return 1
  [[ $(umami_menu_block_state "$file") == "one" && -f $UMAMI_HOOK ]]
}

# Clear state left by older releases first: the shell's own loader may have
# opened a background from an unmarked legacy folder before this runs.
umami_legacy_clean

if ! "$root/bin/umami-install" --check; then
  if block_is_stale; then
    if "$root/bin/umami-install" --yes </dev/null >/dev/null 2>&1; then
      umami_notify "Umami: updated its menu and hook"
    fi
  else
    offer_setup
  fi
fi
