#!/bin/bash
# Pick wallpapers from a shuffled bag: every wallpaper is shown once before any
# repeats, and the bag survives reboots. The timer is a systemd user timer that
# runs "tick"; there is no process of ours running in between.
#
# Whatever is chosen is also held as the pin, so a theme change keeps it.
#
# Usage: umami-shuffle now | tick | start <minutes> | custom | stop [--quiet]
#                    | scope <theme|folder|all> | is <interval N|custom|scope S|on|off>

set -uo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
source "$root/lib/common.sh"
source "$root/lib/shuffle.sh"

bag="$UMAMI_STATE/bag"
mkdir -p "$UMAMI_STATE"
umami_private_cache

state() { cat "$UMAMI_STATE/$1" 2>/dev/null; }
minutes() { state shuffle.minutes; }
scope() { local s; s=$(state shuffle.scope); printf '%s' "${s:-all}"; }

valid_minutes() { [[ $1 =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 1440)); }

# Changes when the user picks a different wallpaper folder, so the bag is rebuilt.
folders_signature() { md5sum <"$UMAMI_CONFIG/folders" 2>/dev/null | cut -c1-8; }

# Refill the bag from a scope, in random order, never starting on what is showing.
refill() { # <bag key> <scope>
  local current first
  "$root/libexec/umami-scan" "$2" | cut -f2 | shuf >"$bag"
  current=$(umami_current_background)
  first=$(head -n1 "$bag")
  if [[ -n $first && $first == "$current" ]] && (($(wc -l <"$bag") > 1)); then
    { tail -n +2 "$bag"; printf '%s\n' "$first"; } >"$bag.new" && mv -f "$bag.new" "$bag"
  fi
  printf '%s' "$1" >"$UMAMI_STATE/bag.key"
}

# Print the next wallpaper that still exists, taking it out of the bag.
next_wallpaper() {
  local sc key lines candidate refilled=false
  sc=$(scope)
  key="$sc:$(folders_signature)"
  [[ $sc == "theme" ]] && key="theme:$(umami_current_theme)"
  if [[ $(state bag.key) != "$key" || ! -s $bag ]]; then
    refill "$key" "$sc"
    refilled=true
  fi
  while true; do
    mapfile -t lines <"$bag"
    if ((${#lines[@]} == 0)); then
      $refilled && return 1
      refill "$key" "$sc"
      refilled=true
      continue
    fi
    candidate=${lines[0]}
    if ((${#lines[@]} > 1)); then printf '%s\n' "${lines[@]:1}" >"$bag.new"; else : >"$bag.new"; fi
    mv -f "$bag.new" "$bag"
    if [[ -f $candidate ]]; then printf '%s' "$candidate"; return 0; fi
  done
}

# Apply the next wallpaper and hold it as the pin. Skips quietly if a carousel is open.
pick() {
  local path
  exec 9>"$UMAMI_CACHE/browse.lock"
  flock -n 9 || return 0
  path=$(next_wallpaper) || umami_die "no backgrounds to shuffle in: $(scope)"
  omarchy-theme-bg-set "$path" || umami_die "could not set $path"
  printf '%s\n' "$path" >"$UMAMI_STATE/pinned"
}

set_scope() {
  case $1 in theme | folder | all) ;; *) umami_die "unknown scope: $1" ;; esac
  printf '%s\n' "$1" >"$UMAMI_STATE/shuffle.scope"
  umami_notify "Shuffling from: $(scope_label "$1")"
}

scope_label() { case $1 in theme) echo "this theme" ;; folder) echo "your custom folder" ;; *) echo "all backgrounds" ;; esac; }

start() { # <minutes>
  valid_minutes "$1" || umami_die "minutes must be a whole number from 1 to 1440"
  local m=$((10#$1))
  [[ -n $("$root/libexec/umami-scan" "$(scope)") ]] || umami_die "no backgrounds to shuffle in: $(scope_label "$(scope)")"
  umami_shuffle_units_write "$root" "$m" || exit 1
  if ! { systemctl --user daemon-reload && systemctl --user enable umami-shuffle.timer && systemctl --user restart umami-shuffle.timer; } >/dev/null 2>&1; then
    umami_shuffle_units_remove
    umami_die "could not start the timer (is your systemd user session running?)"
  fi
  printf '%s\n' "$m" >"$UMAMI_STATE/shuffle.minutes"
  pick
  local every="$m minutes"
  if ((m == 1)); then every="minute"; fi
  umami_notify "Shuffling every $every, from $(scope_label "$(scope)")"
}

stop() {
  umami_shuffle_units_remove
  rm -f -- "$UMAMI_STATE/shuffle.minutes"
  [[ ${1:-} == "--quiet" ]] || umami_notify "Shuffle off"
}

custom() {
  local answer
  local title="Minutes between wallpapers"
  answer=$(omarchy-menu-input "$title" --width "$(umami_menu_width "$title")") || exit 0
  [[ -n $answer ]] || exit 0
  start "$answer"
}

# Exit status only; the menu uses these for its check marks.
is() {
  local m
  m=$(minutes)
  case $1 in
    interval) [[ $m == "$2" ]] ;;
    custom) [[ -n $m && " ${UMAMI_PRESETS[*]} " != *" $m "* ]] ;;
    scope) [[ $(scope) == "$2" ]] ;;
    on) [[ -n $m ]] ;;
    off) [[ -z $m ]] ;;
    *) return 2 ;;
  esac
}

case ${1:-} in
  now) pick ;;
  tick) is on && pick ;;
  start) start "${2:-}" ;;
  custom) custom ;;
  stop) stop "${2:-}" ;;
  scope) set_scope "${2:-}" ;;
  is) is "${2:-}" "${3:-}" ;;
  *) umami_die "usage: umami-shuffle now|tick|start <minutes>|custom|stop|scope <theme|folder|all>|is …" ;;
esac
