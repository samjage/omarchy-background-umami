#!/bin/bash
# Go back to the current theme's own wallpaper and forget any pinned one.

set -uo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
source "$root/lib/common.sh"

mapfile -t images < <(find -L "$OMARCHY_STATE/current/theme/backgrounds" -maxdepth 1 -type f "${UMAMI_IMAGES[@]}" 2>/dev/null | sort)
((${#images[@]})) || umami_die "this theme has no wallpapers to go back to"

rm -f -- "$UMAMI_STATE/pinned"
"$root/libexec/umami-shuffle" stop --quiet
# The first one that passes the safety check (see umami_apply).
for image in "${images[@]}"; do
  umami_apply "$root" "$image" >/dev/null && exit 0
done
umami_die "none of this theme's wallpapers could be safely applied"
